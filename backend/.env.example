# SQLite works immediately. For MySQL, use:
# DATABASE_URL=mysql+pymysql://eduscan:change-me@127.0.0.1:3306/eduscan?charset=utf8mb4
DATABASE_URL=sqlite:///./data/eduscan.db
EDUSCAN_SECRET_KEY=replace-with-a-random-64-character-secret
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EDUSCAN_ENCRYPTION_KEY=
LBPH_THRESHOLD=65
BIOMETRIC_MIN_SAMPLES=15
BIOMETRIC_ENABLED=true
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:5173,http://localhost:5174

# Optional official template path. It can also be uploaded through the API.
SF2_TEMPLATE_PATH=

# Android SMS Gateway local-server settings. Password may instead be saved encrypted in System Setup.
SMS_GATEWAY_ENABLED=false
SMS_GATEWAY_URL=http://192.168.1.100:8080
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
